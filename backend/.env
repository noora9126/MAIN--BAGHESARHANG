PORT=5000
NODE_ENV=production

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=baghsarhang_db

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRE=24h

FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5000

# Zarinpal (sandbox=1 uses sandbox gateway)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1

# ─────────── ملی‌پیامک (MeliPayamak) ───────────
# روش اصلی: کنسول ملی‌پیامک (Auth Token) — توکن را از https://console.melipayamak.com بگیرید
# ⚠️ این توکن «shared» برای پیامکِ خدماتی (پترن/قالب) است؛ پیامک خدماتی حتی برای گیرنده‌هایی
#    که تبلیغاتی را بسته‌اند یا بلک‌لیست کرده‌اند نیز ارسال می‌شود.
MELIPAYAMAK_API_TOKEN=d7412a040e79439600aa2eeaa2aa2e02083aa
# شماره ارسال‌کننده (از پنل/کنسول ملی‌پیامک)
MELIPAYAMAK_SENDER=50004001127910
# آیدی یاتن متن پیش‌فرض (پترن) تأییدشده برای کد تأیید — از بخش «پیام تبلیغاتی/خدماتی» بگیر
MELIPAYAMAK_OTP_BODY_ID=2621244068
# روش جایگزین (پیش‌فرض فعال): نام کاربری و رمز عبور پنل
MELIPAYAMAK_USERNAME=9127910503
MELIPAYAMAK_PASSWORD=2e2411ab-7c95-45f0-9b8d-249578b3215c
# console.melipayamak.com - Auth Token (send/shared)
MELIPAYAMAK_API_TOKEN=d5089ce48e794396bcec2e58332b060a
# bodyId of approved pattern ("مهمان گرامی هتل باغ سرهنگ کد تایید شما {0} می باشد")
MELIPAYAMAK_OTP_BODY_ID=468459
# شبیه‌سازی پیامک فقط با SMS_SIMULATE=1 فعال می‌شود (در پروداکشن هرگز فعال نکنید)
SMS_SIMULATE=0
# Admin seed (used by npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=مدیر هتل
ADMIN_EMAIL=admin@baghsarhang.ir
