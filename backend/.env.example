# Environment variables for the backend (VARIZA payment gateway integration)
# Some of these are sensitive and must NOT be committed to version control.

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=baghsarhang_jadid

# Auth
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Frontend URL (used for callback / return URLs)
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5000

# Zarinpal (legacy / rollback)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1

# Melipayamak (sms service) — real tokens must be obtained from the Melipayamak panel
MELIPAYAMAK_API_TOKEN=
MELIPAYAMAK_SENDER=
MELIPAYAMAK_SHARED_TOKEN=
MELIPAYAMAK_OTP_BODY_ID=468459
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=

SMS_SIMULATE=0

# Admin
ADMIN_USERNAME=amiraliriazi_hotel_manager
ADMIN_PASSWORD="V7!qR2#Lm9@Xz4$Np8"
ADMIN_NAME=مدیر هتل
ADMIN_EMAIL=admin@baghsarhang.ir

# ─────────── Variza (پرداخت کارت‌به‌کارت) ───────────
# کلید API از پنل واریزا ← پروفایل ← کلید API (فقط سمت سرور؛ هرگز در Frontend/Git قرار نگیرد)
VARIZA_API_KEY=
# Secret امضای Webhook از پنل واریزا (فقط سمت سرور)
VARIZA_WEBHOOK_SECRET=
# مهلت اعتبار لینک پرداخت (30m | 1h | 2h | 6h | 1d | 3d | 1w | never) — توصیه رسمی: حداکثر 1h
VARIZA_LINK_EXPIRY=1h
# تلورانس تطبیق مبلغ Webhook نسبت به مبلغ سفارش (درصد) — واریزا برای شناسایی تراکنش
# مبلغ نمایش‌داده‌شده را کمی بیشتر می‌کند (مثال مستندات: لینک 500000 ← وب‌هوک 500128)
VARIZA_AMOUNT_TOLERANCE_PERCENT=5
# Timeout فراخوانی API واریزا (میلی‌ثانیه)
VARIZA_API_TIMEOUT_MS=15000
#
# ⚠️ تنظیمات لازم در پنل واریزا (یک‌بار):
#   1) پروفایل ← callback_url را ثبت کنید:
#      https://YOUR-DOMAIN/api/payments/variza/webhook
#      بدون آن ساخت لینک با خطای 422 شکست می‌خورد.
#   2) FRONTEND_URL باید https دامنه واقعی باشد چون به‌عنوان return_url استفاده می‌شود.
FRONTEND_URL=https://YOUR-DOMAIN